# Backend settings (copy to .env next to this file). Names only, never commit .env.

# n8n production webhook for the ResumeLens workflow, e.g.
# http://localhost:5678/webhook/<webhook-path>
N8N_WEBHOOK_URL=
# Optional shared secret sent as the X-ResumeLens-Secret header (checked by n8n, Phase 3)
N8N_WEBHOOK_SECRET=

# Optional storage locations (defaults shown)
DB_PATH=data/resumelens.db
RESUME_DIR=data/resumes
